{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "DonationHub",
    "Audience": "DonationHub.Client",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },

  "SeedAdmin": {
    "Email": "admin@example.com",
    "FullName": "System Administrator"
  },

  "Donation": {
    "MinAmount": 1.00,
    "MaxAmount": 10000.00,
    "PendingTimeoutMinutes": 30,
    "DefaultCurrency": "USD"
  }
}
